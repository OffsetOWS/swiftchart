# SwiftChart VPS environment template.
# Copy this file to /opt/swiftchart/.env on the VPS and fill in secrets there.

# Frontend
# Use empty string when frontend and API are served from the same VPS/domain.
VITE_API_BASE=
VITE_EXECUTION_API_BASE=
VITE_TELEGRAM_BOT_URL=https://t.me/SwiftChartBot
VITE_HYPERLIQUID_REFERRAL_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GENLAYER_NETWORK=studionet
VITE_GENLAYER_CONTRACT_ADDRESS=
VITE_GENLAYER_CONTRACT_ENDPOINT=

# Backend
APP_NAME=SwiftChart
ENVIRONMENT=production
DATABASE_URL=sqlite:////opt/swiftchart/swiftchart.db
HYPERLIQUID_BASE_URL=https://api.hyperliquid.xyz
SUPABASE_JWT_SECRET=
WEBHOOK_SIGNING_SECRET=
WEBHOOK_NONCE_TTL_SECONDS=900
WEBHOOK_CLOCK_SKEW_SECONDS=300
INTERNAL_API_SECRET=
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENV=practice
OANDA_BASE_URL=https://api-fxpractice.oanda.com
# Legacy aliases OANDA_API_TOKEN and OANDA_ENVIRONMENT are also accepted.
OANDA_REQUEST_TIMEOUT_SECONDS=12
OANDA_RETRY_ATTEMPTS=3
OANDA_RETRY_BACKOFF_SECONDS=0.5
# Retained only as the graceful Forex fallback.
TWELVE_DATA_API_KEY=
FOREX_SCANNER_ENABLED=true
FOREX_ENABLED_TIMEFRAMES=15M,1H,4H,1D
FOREX_CANDLE_CLOSE_DELAY_SECONDS=15
FOREX_BOOTSTRAP_CANDLE_LIMIT=500
FOREX_INCREMENTAL_CANDLE_LIMIT=8
FOREX_DATA_LOCK_TIMEOUT_SECONDS=20
FOREX_DATA_LOCK_STALE_SECONDS=90
FOREX_RISK_PERCENTAGE_PER_TRADE=1
FOREX_MAX_MONETARY_RISK_PER_TRADE=1000
FOREX_MIN_STOP_PIPS=1
FOREX_MAX_STOP_PIPS=300
FOREX_MIN_POSITION_SIZE=1
FOREX_MAX_POSITION_SIZE=10000000
FOREX_MAX_TOTAL_OPEN_RISK_PERCENTAGE=3
FOREX_MAX_CORRELATED_EXPOSURE=2
FOREX_SCAN_INTERVAL_SECONDS=900
FOREX_SCAN_1H_INTERVAL_SECONDS=3600
FOREX_SCAN_4H_INTERVAL_SECONDS=14400
FOREX_SCAN_1D_INTERVAL_SECONDS=86400
FOREX_LIFECYCLE_INTERVAL_SECONDS=60
FOREX_WORKER_STARTUP_DELAY_SECONDS=20
FOREX_DXY_CONTEXT_ENABLED=true
FOREX_OIL_CONTEXT_ENABLED=true
FOREX_CROSS_MARKET_MAX_POSITIVE_ADJUSTMENT=10
FOREX_CROSS_MARKET_MAX_NEGATIVE_ADJUSTMENT=-10
FOREX_LIQUIDITY_FVG_LIMIT_ENABLED=false
FOREX_LIQUIDITY_FVG_LIMIT_SHADOW_MODE=true
FOREX_LIQUIDITY_FVG_AUTO_EXECUTION_ENABLED=false
FOREX_FVG_ENTRY_MODE=FVG_MIDPOINT
FOREX_FVG_MIN_GAP_ATR=0.10
FOREX_FVG_MIN_GAP_PIPS=2
FOREX_FVG_DISPLACEMENT_ATR=1.0
FOREX_FVG_MAX_CANDLES_AFTER_SWEEP=3
FOREX_FVG_EXPIRY_1H_CANDLES=8
FOREX_FVG_EXPIRY_4H_CANDLES=6
FOREX_FVG_EXPIRY_1D_CANDLES=3
FOREX_CLOSE_ENTIRE_POSITION_AT_TP1=false
FRONTEND_ORIGINS=http://156.67.30.173,https://YOUR_DOMAIN,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
LIVE_TRADING_ENABLED=false
DEFAULT_EXCHANGE=hyperliquid
DEFAULT_TIMEFRAME=4h
DEFAULT_ACCOUNT_SIZE=10000
DEFAULT_RISK_PER_TRADE=1
DEFAULT_MIN_RR=2
DEFAULT_MAX_OPEN_TRADES=3
MIN_PERP_VOLUME_24H=100000
API_RATE_LIMIT_PER_MINUTE=120
SCANNER_RATE_LIMIT_PER_MINUTE=20
SIGNAL_MAX_AGE_MINUTES=1440
SIGNAL_MAX_ENTRY_DEVIATION_PERCENT=1.5
TRADE_HISTORY_EXPIRY_BARS=12

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=
TELEGRAM_ALERT_CHAT_IDS=
ALERTS_ENABLED=true
ALERT_EXCHANGE=hyperliquid
ALERT_TIMEFRAME=4h
ALERT_SCAN_INTERVAL_SECONDS=1800
FOREX_TELEGRAM_DISPATCH_INTERVAL_SECONDS=60
FOREX_TELEGRAM_DISPATCH_STARTUP_DELAY_SECONDS=10
ALERTS_RUN_SECRET=
ALERTS_RUN_RATE_LIMIT_PER_MINUTE=6
BOT_STATE_PATH=/opt/swiftchart/.swiftchart_bot_state.json
HYPERLIQUID_API_KEY=

# Execution Bot
# Default is safe paper trading. Live mode requires both values below.
EXECUTION_DATABASE_URL=sqlite:////opt/swiftchart/execution_bot.db
EXECUTION_WEBHOOK_SECRET=
EXECUTION_CORS_ORIGINS=
EXECUTION_AUTH_CLOCK_SKEW_SECONDS=300
EXECUTION_NONCE_TTL_SECONDS=900
EXECUTION_AUTOTRADE_ENABLED=false
EXECUTION_SIGNAL_WEBHOOK_URL=http://127.0.0.1:8100/webhook/signal
EXECUTION_MODE=paper
EXECUTION_LIVE_CONFIRM=false
LIVE_TRADING=false
AUTO_EXECUTE=false
EXECUTION_EXCHANGE=mock
EXECUTION_TELEGRAM_BOT_TOKEN=
EXECUTION_TELEGRAM_ADMIN_ID=
EXECUTION_TELEGRAM_POLLING_ENABLED=true
EXECUTION_QUOTE_ASSET=USDT
STARTING_BALANCE=100
TARGET_BALANCE=1000
BASE_RISK_PERCENT=2
MAX_RISK_PERCENT=5
MAX_DAILY_LOSS_PERCENT=8
MAX_WEEKLY_LOSS_PERCENT=15
MAX_OPEN_TRADES=2
MAX_LEVERAGE=5
MAX_CONSECUTIVE_LOSSES=3
MIN_CONFIDENCE_TO_TRADE=75
MAX_EXPOSURE_PER_COIN_PERCENT=45
MIN_ORDER_NOTIONAL=10
COOLDOWN_AFTER_LOSS_MINUTES=30
SIGNAL_TTL_SECONDS=900
DUPLICATE_WINDOW_SECONDS=3600
MIN_ATR_PERCENT=0.08
MAX_ATR_PERCENT=8
MAX_SPREAD_PERCENT=0.25
MIN_VOLUME_RATIO=0.55
EXECUTION_SYMBOL_ALLOWLIST=BTCUSDT,ETHUSDT,SOLUSDT
MAX_ENTRY_DEVIATION_PERCENT=0.75
MAX_SIGNAL_CANDLE_AGE_SECONDS=900
MAX_RISK_PER_TRADE_PERCENT=5
CIRCUIT_BREAKER_MAX_FAILURES=3
CIRCUIT_BREAKER_WINDOW_SECONDS=900
HYPERLIQUID_WALLET_ADDRESS=
HYPERLIQUID_PRIVATE_KEY=
HYPERLIQUID_API_WALLET_ADDRESS=
HYPERLIQUID_API_KEY=
HYPERLIQUID_API_SECRET=
APP_BASE_URL=https://swiftchart.xyz
