{
  "version": 2,
  "framework": "vite",
  "installCommand": "cd frontend && npm install",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "http://156.67.30.173/api/$1"
    },
    {
      "source": "/health",
      "destination": "http://156.67.30.173/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
