{
  "version": 2,
  "framework": "vite",
  "installCommand": "cd frontend && npm install",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "swiftchart.vercel.app"
        }
      ],
      "destination": "https://swiftchart.xyz",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "swiftchart.vercel.app"
        }
      ],
      "destination": "https://swiftchart.xyz/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "http://13.140.179.82/api/$1"
    },
    {
      "source": "/health",
      "destination": "http://13.140.179.82/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
